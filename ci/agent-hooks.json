// Agent-neutral engine guards. `ci/install.cs` is the only renderer: it translates these entries
// into Claude's settings.json and Codex's hooks.json. Add, remove or change a guard here; never
// hand-edit either generated runtime configuration.
//
// `script` is relative to the engine root. The scripts themselves live in `.agents/hooks`, with
// `.claude/hooks` retained as a symlink for older links and external documentation.
//
// JSON with // comments and trailing commas allowed.
{
  "hooks": [
    {
      // Query and model anti-patterns: DB calls inside loops, persisted bool columns, missing indexes.
      // Canonical rules: Docs/data-design.md.
      "event": "PreToolUse",
      "matcher": "Write|Edit|MultiEdit",
      "script": ".agents/hooks/DbGuard.cs",
      "timeout": 60,
    },
    {
      // An unauthorized endpoint that dereferences the current identity or writes data.
      "event": "PreToolUse",
      "matcher": "Write|Edit|MultiEdit",
      "script": ".agents/hooks/ApiAuthGuard.cs",
      "timeout": 60,
    },
    {
      // A JSON serializer or parser other than ZJson, or JSON assembled by hand in a string. Judges only what an
      // edit adds; `-- --audit <dir>` lists everything.
      "event": "PreToolUse",
      "matcher": "Write|Edit|MultiEdit",
      "script": ".agents/hooks/JsonGuard.cs",
      "timeout": 60,
    },
    {
      // Hand-rolled schema changes. Matches Bash too, since DDL can arrive through a mysql client or
      // ExecuteSqlRaw rather than an editor tool (data-design.md §6).
      "event": "PreToolUse",
      "matcher": "Write|Edit|MultiEdit|Bash",
      "script": ".agents/hooks/MigrationGuard.cs",
      "timeout": 60,
    },
    {
      // Whole-repo index audit, gated to edits that touch query surface. Accepted debt is pinned in
      // the repo's own .claude/IndexAudit.baseline.
      "event": "PostToolUse",
      "matcher": "Write|Edit|MultiEdit",
      "script": ".agents/hooks/IndexAudit.cs",
      "arguments": ["--hook"],
      "timeout": 90,
    },
  ],
}
